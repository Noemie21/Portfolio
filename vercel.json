{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/documind", "destination": "/documind/index.html" },
    { "source": "/documind/", "destination": "/documind/index.html" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
